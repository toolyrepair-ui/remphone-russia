RewriteEngine On

# Служебные пути не отдавать, даже если папку случайно залили.
RewriteRule ^\.git - [F,L]
RewriteRule ^\.env - [F,L]

# HTTP → HTTPS. Перед Apache стоит nginx: %{HTTPS} у бэкенда всегда off,
# поэтому смотрим X-Forwarded-Proto. Правило — до /docs/ и /seo/.
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www → без www на HTTPS.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# Внутренние папки: на GitHub Pages этот файл не работает,
# на Apache (reg.ru) — 404, даже если файл случайно залили.
RewriteRule ^docs(/.*)?$ - [R=404,L]
RewriteRule ^seo(/.*)?$ - [R=404,L]

# Старые хабы /cities/*.html → канонические городские URL.
# Только точные файлы, не подпапки cities/khabarovsk/*.html
RewriteRule ^cities/khabarovsk\.html$ /khabarovsk/ [L,R=301]
RewriteRule ^cities/komsomolsk\.html$ /komsomolsk-na-amure/ [L,R=301]
RewriteRule ^cities/vladivostok\.html$ /vladivostok/ [L,R=301]

ErrorDocument 404 /404.html

# Служебные файлы (состояние FTP-выгрузки и прочие dotfiles) не отдавать.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Кеш статики на месяц. HTML и JSON не трогать — цены должны обновляться сразу.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://mc.yandex.ru https://mc.yandex.com https://yastatic.net https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://mc.yandex.ru https://mc.yandex.com https://yastatic.net https://www.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com https://yastatic.net https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://rem-phone-relay.toolyrepair.workers.dev https://ipwho.is https://cdn.jsdelivr.net wss://mc.yandex.ru wss://mc.yandex.com; frame-src https://mc.yandex.ru https://mc.yandex.com; worker-src 'self' blob:; form-action 'self' https://t.me https://wa.me; upgrade-insecure-requests"
  <FilesMatch "\.(css|js|png|jpe?g|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 month"
</IfModule>
